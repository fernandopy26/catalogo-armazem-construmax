rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    /*
      Modo atual seguro contra visitantes anônimos:
      - qualquer pessoa pode ler o catálogo público;
      - somente usuários autenticados no Firebase Auth podem administrar.

      Quando quiser endurecer mais, troque signedIn() por uma função isAdmin()
      baseada em custom claims ou lista de UIDs. Não faça essa troca antes de
      criar o admin, para evitar perder acesso ao painel.
    */

    // Configuração da loja
    match /config/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Catálogo público otimizado: documento gerado pelo painel admin
    match /catalogo/publico {
      allow read: if true;
      allow write: if signedIn();
    }

    // Categorias e itens
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if signedIn();

      match /itens/{itemId} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    // Analytics: visitantes incrementam contadores; admin autenticado lê/apaga
    match /analytics/{date} {
      allow read, delete: if signedIn();
      allow create, update: if true;
    }
  }
}
